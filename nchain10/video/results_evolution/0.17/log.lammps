     2 = max # of 1-2 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.003 seconds
comm_modify cutoff 3.0
# Define groups
group           all type 1
300 atoms in group all

# Force field parameters
# WCA potential (repulsive LJ with cutoff at 2^(1/6))
pair_style      lj/cut 1.1224620483093729814335330496792
pair_coeff      1 1 1.0 1.0 1.1224620483093729814335330496792
pair_modify     shift yes

# FENE bonds (K=30, R0=1.5)
bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0

# Cosine angle potential
angle_style     cosine
angle_coeff     1 30.0

# Set timestep
timestep        0.01

# Custom BD fix with spherical confinement and active force
# r_sphere will be calculated automatically from box size
# Arguments: ID group bd/sphere gamma T Fext seed mchain value
#fix             bd all bd/sphere 1000.0 5.0 1.0 12345 mchain 30
#
## Output
#thermo_style    custom step temp ke pe etotal press
#thermo          10000
#
## Equilibration phase
#dump            1 all xyz 100000 traj_equil_T_5_F_1.xyz
#dump_modify     1 sort id
#run             50000000
#undump          1
#unfix           bd
########################################################################
#fix             bd all bd/sphere 1000.0 2.0 1.0 25345 mchain 30
#
## Output
#thermo_style    custom step temp ke pe etotal press
#thermo          10000
#
## Equilibration phase
#dump            2 all xyz 100000 traj_equil_T_2_F_1.xyz
#dump_modify     2 sort id
#run             1000000
#undump          2
#unfix           bd
#########################################################################
#fix             bd all bd/sphere 1000.0 2.0 0.0 12345 mchain 30
#
## Output
thermo_style    custom step temp ke pe etotal press
thermo          10000
#
## Equilibration phase
#dump            3 all xyz 100000 traj_equil_T_2_F_0.xyz
#dump_modify     3 sort id
#run             1000000
#undump          3
#unfix           bd


# Reset timestep to 0
reset_timestep  0

# Write initial sample
write_dump      all xyz out-0000000000.xyz modify sort id
WARNING: Calling write_dump before a full system init (src/write_dump.cpp:89)

# Write restart file
#write_restart   equil.restart

# Production phase
#unfix           bd
# Arguments: ID group bd/sphere gamma T Fext seed mchain value
fix             bd all bd/sphere 1000.0 1.0 0.17 22345 mchain 30

# Save configurations
dump            4 all custom 100000 out-*.xyz id type x y z
dump_modify     4 pad 10 sort id

# Run production
#restart         100000 out-*.data
restart         10000000 restart_F0_A.bin restart_F0_B.bin
#run             1000000
run             100000000
