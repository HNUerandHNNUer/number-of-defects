# Resume the F=0 production stage. Original checkpoint remains untouched.
variable target index 100000000
variable tag index production
units lj
atom_style molecular
read_restart ../restart_F25_A.bin
neighbor 0.5 bin
neigh_modify every 1 delay 0 check yes
comm_modify cutoff 3.0
pair_modify shift yes
timestep 0.01
fix bd all bd/sphere 1000.0 1.0 0.0 82404693 mchain 30
thermo_style custom step temp ke pe etotal press
thermo 10000
thermo_modify flush yes
dump traj all custom 100000 ${tag}-out-*.xyz id type x y z
dump_modify traj pad 10 sort id
restart 1000000 ${tag}-restart_A.bin ${tag}-restart_B.bin
run ${target} upto
write_restart ${tag}-final.bin
